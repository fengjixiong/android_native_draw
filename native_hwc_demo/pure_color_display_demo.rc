# /vendor/etc/init/ or /system/etc/init/
service vendor.pure_color_display_demo /vendor/bin/pure_color_display_demo
    class main
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    seclabel u:r:hal_graphics_composer_default:s0
	# optional
    oneshot                    # run once
    disabled                   # manual start
    task_profiles ServiceCapacityLow
    priority -10               # priority