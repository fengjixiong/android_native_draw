LOCAL_PATH := $(call my-dir)

# ====== 预编译库 libcompany_framework.so =====
include $(CLEAR_VARS)
LOCAL_MODULE := company_framework
LOCAL_SRC_FILES := company_framework/prebuild_libs/$(TARGET_ARCH_ABI)/libcompany_framework.so
LOCAL_EXPORT_C_INCLUDES := $(LOCAL_PATH)/company_framework/public
include $(PREBUILT_SHARED_LIBRARY)

# ====== 预编译库 libcompany_demo_core.so =====
include $(CLEAR_VARS)
LOCAL_MODULE := company_demo_core
LOCAL_SRC_FILES := company_demo_core/prebuild_libs/$(TARGET_ARCH_ABI)/libcompany_demo_core.so
LOCAL_EXPORT_C_INCLUDES := $(LOCAL_PATH)/company_demo_core/public
include $(PREBUILT_SHARED_LIBRARY)

#======= 编译 native_render_demo ============
include $(CLEAR_VARS)
LOCAL_MODULE       := native_render_demo
LOCAL_C_INCLUDES += $(LOCAL_PATH)/public
LOCAL_C_INCLUDES += $(LOCAL_PATH)/src
LOCAL_SRC_FILES  := src/main_utils.cpp
LOCAL_SRC_FILES  += src/company_test.cpp
LOCAL_SRC_FILES  += src/main_render.cpp
LOCAL_CFLAGS += -Wall -std=c++14
LOCAL_CFLAGS += -DLOG_TAG=\"native_render_demo\"
APP_STL := c++_static
APP_CPPFLAGS += -std=c++14
LOCAL_STRIP_MODULE := false
LOCAL_SHARED_LIBRARIES := company_framework
LOCAL_SHARED_LIBRARIES += company_demo_core
LOCAL_LDLIBS = -llog
LOCAL_LDFLAGS += "-Wl,-z,max-page-size=16384"
include $(BUILD_EXECUTABLE)
